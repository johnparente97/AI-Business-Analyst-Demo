# ==============================================================================
# InsightBridge AI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env or configure in .streamlit/secrets.toml
#
#   cp .env.example .env
#
# ==============================================================================

# LLM Provider Selection: "openai", "huggingface", or leave unset for auto-detect / offline fallback
LLM_PROVIDER=openai

# --- OpenAI Configuration ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Hugging Face Configuration (Alternative) ---
# HF_API_TOKEN=hf_your_token_here

# --- Public Data Connectors (Optional) ---
# FRED API Key for Federal Reserve Economic Data (Free at https://fred.stlouisfed.org)
FRED_API_KEY=
